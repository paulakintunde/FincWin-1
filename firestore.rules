rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user owns exactly one document keyed by their Firebase uid.
    // Reads and writes are blocked for every other uid and all unauthenticated requests.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
