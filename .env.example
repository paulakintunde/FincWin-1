# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real API keys.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# Lemon Squeezy API key — license validation/activation (api/validate.js, api/activate.js, api/deactivate.js)
# Get this from: https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_API_KEY=your_lemon_squeezy_api_key_here

# Resend API key — transactional email for the contact form (api/contact.js)
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Admin token — guards the admin endpoint (api/admin.js).
# Generate a long random string; it must be supplied in the admin request.
ADMIN_TOKEN=your_admin_token_here
